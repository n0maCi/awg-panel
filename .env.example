# Скопируйте этот файл в .env. Одинарные кавычки сохраняют символы $ в bcrypt-хеше.
PASSWORD_HASH='$2b$12$REPLACE_WITH_A_REAL_BCRYPT_HASH'
AWG_HOST=203.0.113.10

# 1.5, 2 или 3.1
AWG_VERSION=3.1
AWG_PORT=51820
UI_PORT=51821

AWG_INTERFACE=awg0
AWG_ADDRESS=10.8.0.1/24
AWG_DEVICE=eth0
AWG_DNS=1.1.1.1,1.0.0.1
AWG_ALLOWED_IPS=0.0.0.0/0,::/0
AWG_MTU=1420
AWG_PERSISTENT_KEEPALIVE=25

# Включите за HTTPS reverse proxy.
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Кластеризация отключена по умолчанию. Для кластера назначьте ровно один primary.
CLUSTER_ROLE=standalone
CLUSTER_NODE_ID=vpn-1
# Один и тот же секрет длиной не менее 32 символов на всех узлах: openssl rand -base64 48
# CLUSTER_SECRET=replace-with-a-long-random-secret
# На primary: URL всех replica через запятую. На replica: URL primary.
# CLUSTER_PEERS=http://10.0.0.12:51821,http://10.0.0.13:51821
CLUSTER_SYNC_INTERVAL_SECONDS=15
CLUSTER_REQUEST_TIMEOUT_SECONDS=5

# Необязательные переопределения обфускации. Обычно автоматические значения лучше.
# AWG_JC=6
# AWG_JMIN=40
# AWG_JMAX=120
# AWG_S1=64
# AWG_S2=96
# AWG_S3=32
# AWG_S4=16
# AWG_H1=1
# AWG_H2=2
# AWG_H3=3
# AWG_H4=4
# AWG_I1=<b 0x16030100><r 32>
# AWG_HEADER_PROTECTION_KEY=<32-byte-base64-key>
# AWG_CONTENT_PADDING_ADDITION=16-64
# AWG_REKEY_AFTER_TIME=3000-4000
# AWG_REKEY_TIMEOUT=5-10
# AWG_REJECT_AFTER_TIME=180-190
# AWG_KEEPALIVE_TIMEOUT=8-15
# AWG_MAX_HANDSHAKE_ATTEMPTS=15-20
# AWG_RANDOM_TRAILERS=on
# AWG_DISABLE_COOKIES=off
